# Paste inside the HTTPS server{} that serves /play/.
# Upgrades /play/api/gamews to the game relay on :20712.
#
#   wss://HOST/play/api/gamews?host=1.2.3.4&port=28960
#     → ws://127.0.0.1:20712/?host=1.2.3.4&port=28960

location /play/api/gamews {
    proxy_pass http://127.0.0.1:20712/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # The relay limits sessions per browser address (trusted from loopback only).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
