output/*
!output/data_home_map.json
*.o
*.a
*.so
*.exe
*.pyc
__pycache__/
.DS_Store
toolchain/

# CMake out-of-source build dirs (one per target; see README.md)
/build-native/
/build-web/
/build-web-wsl/
/build-win32/
/build/web/
build/cmake/
build/web_wasmfs/

# build logs and machine-local emscripten config
/*.log
/emscripten_config.py
*.orig_bak

# stray shell-redirect artifacts (the dir name holds a U+F03A ':' lookalike)
/tatus
/C*Userssipex/

# scratch/diagnostic helpers (the '_' prefix marks throwaway tooling)
/tools/_*

# gfx_d3d renderer DLL build outputs (regenerated by scripts/build_gfx_dll.sh)
build/win32c/gfxdll/
build/win32c/*.dll
build/win32/*.dll
build/win32c/*.bak

# build outputs (regenerable; never commit)
/cod2_linux
/cod2_linux.clean
/cod2_lnxded
/cod2.exe
/cod2_lnxded.exe
build/web/*.wasm
build/web/*.js
# compiled equiv-harness runner (built from native_equiv_runner.c)
utils/decomp/native_equiv_runner

# transient runtime / snapshot artifacts
servercache.dat
*.tar.gz

# generated data blobs (regenerated by CMake into the source/build dirs)
build/win32c/
src/win32/sdl2/lib/*.a

# Proprietary/local game content and test browser profiles
*.iwd
*.pk3
*.zip
*.dmp
*.mdmp
/tools/.runtime/
/assets/
/main/
node_modules/
